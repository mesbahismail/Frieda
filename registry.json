      "css": {
        "@keyframes shimmer": {
          "from": {
            "background-position": "200% 0"
          },
          "to": {
            "background-position": "-200% 0"
          }
        },
        "@keyframes float-in": {
          "from": {
            "opacity": "0",
            "transform": "translateY(8px)"
          },
          "to": {
            "opacity": "1",
            "transform": "none"
          }
        },
        "@layer base": {
          ":root": {
            "color-scheme": "dark"
          },
          "body": {
            "@apply bg-background text-foreground": {},
            "background-image": "linear-gradient(160deg, #2b2b2b 0%, #2e2e2e 45%, #353535 100%)",
            "background-attachment": "fixed",
            "font-feature-settings": "\"tnum\" 0"
          },
          "button:not(:disabled),\n  [role=\"button\"]:not(:disabled)": {
            "cursor": "pointer"
          },
          "::selection": {
            "background": "rgb(21 224 204 / 35%)"
          }
        },
        "@layer components": {
          ".frieda-card": {
            "position": "relative",
            "border-radius": "18px",
            "border": "1px solid rgb(255 255 255 / 5%)",
            "background": "linear-gradient(180deg, #1c1c1c 0%, #212121 60%, #242424 100%)",
            "box-shadow": "0 18px 40px -24px rgb(0 0 0 / 60%)"
          },
          ".frieda-tile": {
            "border-radius": "14px",
            "background": "linear-gradient(180deg, #262626 0%, #2a2a2a 100%)"
          },
          ".frieda-panel": {
            "background": "radial-gradient(70% 45% at 85% 70%, rgb(21 224 204 / 9%) 0%, transparent 70%),\n      radial-gradient(60% 40% at 15% 20%, rgb(255 255 255 / 3%) 0%, transparent 70%),\n      linear-gradient(180deg, #2c2f2f 0%, #2b2d2d 100%)"
          },
          ".frieda-scroll": {
            "scrollbar-width": "thin",
            "scrollbar-color": "rgb(255 255 255 / 12%) transparent"
          },
          ".frieda-scroll::-webkit-scrollbar": {
            "width": "6px",
            "height": "6px"
          },
          ".frieda-scroll::-webkit-scrollbar-thumb": {
            "border-radius": "999px",
            "background": "rgb(255 255 255 / 12%)"
          },
          ".frieda-no-scrollbar": {
            "scrollbar-width": "none"
          },
          ".frieda-no-scrollbar::-webkit-scrollbar": {
            "display": "none"
          },
          ".frieda-grow": {
            "transform-origin": "bottom",
            "animation": "frieda-grow 0.8s cubic-bezier(0.22, 1, 0.36, 1) both"
          },
          ".frieda-grow-x": {
            "transform-origin": "left",
            "animation": "frieda-grow-x 0.9s cubic-bezier(0.22, 1, 0.36, 1) both"
          },
          ".frieda-ring": {
            "animation": "frieda-ring 1s cubic-bezier(0.22, 1, 0.36, 1) both"
          },
          ".frieda-draw": {
            "stroke-dasharray": "1200",
            "animation": "frieda-draw 1.4s ease-out both"
          }
        },
        "@keyframes frieda-grow": {
          "from": {
            "transform": "scaleY(0)"
          }
        },
        "@keyframes frieda-grow-x": {
          "from": {
            "transform": "scaleX(0)"
          }
        },
        "@keyframes frieda-ring": {
          "from": {
            "stroke-dashoffset": "var(--len)"
          }
        },
        "@keyframes frieda-draw": {
          "from": {
            "stroke-dashoffset": "1200"
          },
          "to": {
            "stroke-dashoffset": "0"
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          ".frieda-grow,\n  .frieda-grow-x,\n  .frieda-ring,\n  .frieda-draw": {
            "animation": "none"
          }
        },
        ".frieda-chat[data-chat-theme]": {
          "--chat-font-sans": "var(--font-poppins), ui-sans-serif, system-ui, sans-serif",
          "--chat-bg-app": "transparent",
          "--chat-bg-sidebar": "#1b1b1b",
          "--chat-bg-main": "#262626",
          "--chat-bg-header": "transparent",
          "--chat-bg-composer": "transparent",
          "--chat-bg-content-card": "#2b2b2b",
          "--chat-bg-code": "#181818",
          "--chat-bubble-outgoing": "#15e0cc",
          "--chat-bubble-outgoing-text": "#102422",
          "--chat-bubble-incoming": "#1f1f1f",
          "--chat-bubble-incoming-text": "#f1f1f1",
          "--chat-accent": "#15e0cc",
          "--chat-accent-soft": "rgb(21 224 204 / 10%)",
          "--chat-green": "#15e0cc",
          "--chat-orange": "#fdcc53",
          "--chat-red": "#f7385a",
          "--chat-text-primary": "#f4f4f4",
          "--chat-text-secondary": "#a3a3a3",
          "--chat-text-tertiary": "#6e6e6e",
          "--chat-border": "rgb(255 255 255 / 6%)",
          "--chat-border-strong": "rgb(255 255 255 / 10%)",
          "--chat-shadow-md": "0 8px 24px rgb(0 0 0 / 35%)",
          "--chat-shadow-toolbar": "0 0 0 1px rgb(255 255 255 / 8%)",
          "--chat-bubble-radius": "20px",
          "--chat-spacing-messages": "18px",
          "font-family": "var(--chat-font-sans)"
        },
        ".frieda-chat .chat-bubble p": {
          "font-size": "15px",
          "line-height": "1.6"
        },
        ".frieda-chat .chat-bubble": {
          "padding": "12px 20px",
          "border": "1px solid rgb(255 255 255 / 4%)"
        },
        ".frieda-chat .chat-composer > div": {
          "border-top": "0"
        },
        ".frieda-chat .chat-composer button[aria-label=\"Send message\"]:not(:disabled)": {
          "color": "#0f1f1d"
        }
      }
